{
  "name": "motion-director",
  "version": "0.2.0",
  "description": "Make motion-graphics promo films with Claude: films as code, a studio to review, comment, tune sound and parameters, and a renderer.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Modality-Learning/Motion-Director.git"
  },
  "homepage": "https://github.com/Modality-Learning/Motion-Director#readme",
  "bugs": "https://github.com/Modality-Learning/Motion-Director/issues",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "motion-director": "bin/motion-director.mjs"
  },
  "files": [
    "bin",
    "kit",
    "render",
    "server",
    "skill",
    "templates",
    "dist",
    "vite.config.ts",
    "README.md"
  ],
  "exports": {
    "./kit/*": "./kit/*",
    "./render/*": "./render/*",
    "./server/*": "./server/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "MD_DEV=1 node bin/motion-director.mjs studio --root example",
    "dev:project": "MD_DEV=1 node bin/motion-director.mjs studio --root",
    "build": "tsc -b && vite build",
    "prepare": "vite build",
    "typecheck": "tsc -b",
    "test": "node --test 'kit/*.test.mjs' 'render/*.test.mjs' 'server/*.test.mjs' 'test/*.test.mjs' && vitest run",
    "test:node": "node --test 'kit/*.test.mjs' 'render/*.test.mjs' 'server/*.test.mjs' 'test/*.test.mjs'",
    "test:app": "vitest run"
  },
  "dependencies": {
    "cn": "^0.5.2",
    "next-themes": "^0.4.6",
    "playwright": "^1.65.1",
    "sonner": "^2.0.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.12",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jsdom": "^29.1.1",
    "lucide-react": "^1.73.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.5",
    "tslib": "^2.9.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "zustand": "^5.1.0"
  }
}
